      "description": "Anteil der Antworten mit Statuscode 5xx, Mittel über 5 Minuten. Alarm ab 5 % (7.6).",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(http_server_request_duration_seconds_count{job=\"web\",http_response_status_code=~\"5..\"}[5m])) or vector(0)) / clamp_min(sum(rate(http_server_request_duration_seconds_count{job=\"web\"}[5m])), 1e-9)",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
