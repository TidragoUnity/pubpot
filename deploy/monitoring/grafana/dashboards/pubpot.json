    {
      "type": "timeseries",
      "title": "Anmeldungen pro Tag",
      "description": "Ein Balken pro Tag, letzte 7 Tage: bestätigte Anmeldungen nach Art (gestapelt) und alle gespeicherten (neu oder geändert, Punkt). Der heutige Balken wächst im Lauf des Tages. Prometheus teilt die Tage nach UTC: ein Tag beginnt um 01:00 deutscher Zeit, im Sommer um 02:00.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "round(sum by (kind) (increase(pubpot_signups_confirmed_total[$__interval] offset -$__interval)))",
          "legendFormat": "bestätigt {{kind}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "round(sum(increase(pubpot_signups_total[$__interval] offset -$__interval)))",
          "legendFormat": "gespeichert (alle)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "barAlignment": 1
          },
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "Noch keine Daten",
          "min": 0,
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "gespeichert (alle)"
            },
            "properties": [
              {
                "id": "custom.drawStyle",
                "value": "points"
              },
              {
                "id": "custom.pointSize",
                "value": 10
              },
              {
                "id": "custom.showPoints",
                "value": "always"
              },
              {
                "id": "custom.stacking",
                "value": {
                  "mode": "none",
                  "group": "B"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
