    {
      "type": "stat",
      "title": "Zertifikat",
      "description": "Zeit bis zum Ablauf des HTTPS-Zertifikats. Caddy verlängert automatisch, Alarm unter 14 Tagen. „lokal“: Mit localhost stellt Caddy eigene Zertifikate mit wenigen Stunden Laufzeit aus, die hier nicht zählen.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(min(probe_ssl_earliest_cert_expiry{job=\"website\",tls=\"public\"}) - time()) or on() (0 * max(probe_ssl_earliest_cert_expiry{job=\"website\",tls=\"local\"}) - 1)",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "–",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 1209600
              },
              {
                "color": "green",
                "value": 2592000
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "lokal",
                  "color": "blue",
                  "index": 0
                }
              }
            }
          ],
          "decimals": 0
        },
        "overrides": []
