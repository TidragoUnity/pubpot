# Vorlage für deploy/.env – kopieren und ausfüllen:   cp .env.example .env
# Die echte .env NIE committen (steht in .gitignore).
#
# Compose liest diese Datei nur, um die ${…}-Werte in compose.yaml einzusetzen. Jeder Container bekommt danach
# nur die Variablen, die in compose.yaml bei ihm stehen (E-037).
#
# Lange zufällige Passwörter erzeugen (nur Buchstaben und Ziffern, siehe Hinweis unten), z. B.:
#   PowerShell:  -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 32 | % {[char]$_})
#   Linux:       openssl rand -hex 24
#
# Achtung bei Sonderzeichen: Compose ersetzt "$" in dieser Datei wie eine Variable, und ";" bricht den
# Connection-String der Datenbank. Werte mit Sonderzeichen in einfache Anführungszeichen setzen: KEY='a$b'

# --- Datenbank ---------------------------------------------------------------
# Passwort des Postgres-Superusers "postgres" (nur für Verwaltung und Backups).
POSTGRES_PASSWORD=

# Passwort des Benutzers "pubpot" (Web-App, Datenbank "pubpot").
PUBPOT_DB_PASSWORD=

# Passwort des Benutzers "twitch" (Twitch-Worker, Datenbank "twitch").
TWITCH_DB_PASSWORD=

# Achtung: Die Passwörter werden nur beim ALLERERSTEN Start der Datenbank übernommen.
# Später ändern: im laufenden Postgres per  ALTER ROLE pubpot PASSWORD '…';
# oder lokal alles zurücksetzen mit  docker compose down -v  (löscht alle Daten!).

# --- Domain und Erreichbarkeit (Caddy, E-038) ------------------------------------
# Domain, unter der Caddy die Seite ausliefert. Lokal "localhost" (eigenes Zertifikat, Browser warnt, F-017),
# auf dem Server die echte Domain (Zertifikat automatisch von Let's Encrypt).
# SITE_DOMAIN=localhost

# Wo Caddy die Ports 80 und 443 öffnet. 127.0.0.1 = nur dieser Rechner. Auf dem Server: 0.0.0.0
# BIND_ADDRESS=127.0.0.1

# Subnetz des Netzes "edge" (Caddy ↔ web). Nur ändern, wenn auf demselben Rechner ein zweites PubPot-Projekt
# läuft (z. B. staging neben production): Jedes Subnetz darf es nur einmal geben.
# EDGE_SUBNET=172.30.0.0/24

# --- Web-App -----------------------------------------------------------------
# Lokal sind die Werte in diesem Abschnitt optional: compose.override.yaml setzt passende Werte für Mailpit.
# Auf dem Server sind die SMTP-Werte Pflicht, sonst startet die App nicht.

# Öffentliche Adresse ohne / am Ende. Daraus entstehen alle Links in Mails (nie aus der Anfrage, E-021).
# Standard: https://${SITE_DOMAIN}. Nur setzen, wenn die Adresse davon abweicht.
# Site__BaseUrl=https://pubpot.games

# SMTP-Zugang (EU-Anbieter, siehe docs/CHECKLISTE-SELBST.md). Security: StartTls (Port 587), SslOnConnect (465)
# oder None (nur lokal).
# Smtp__Host=
# Smtp__Port=587
# Smtp__Security=StartTls
# Smtp__Username=
# Smtp__Password=
# Smtp__FromAddress=
# Smtp__FromName=PubPot

# --- Admin-Bereich (/admin) ----------------------------------------------------
# Ohne Hash ist der Admin-Bereich aus (404). Hash erzeugen (fragt das Passwort verdeckt ab):
#   docker compose run --rm --no-deps web hash-password
# Die ausgegebene Zeile hier eintragen. Der Hash enthält kein "$", Anführungszeichen sind nicht nötig.
# Admin__Username=admin
# Admin__PasswordHash=

# --- Hinweise auf neue Anmeldungen (E-030) -------------------------------------
# Mail an diese Adresse bei jeder neu bestätigten Anmeldung (ohne Name und E-Mail der Person).
# Lokal Standard: team@localhost.test (landet in Mailpit).
# Notifications__Email=
# Optional zusätzlich Discord. Die Webhook-URL ist ein Geheimnis: Wer sie kennt, kann in den Kanal schreiben.
# Notifications__DiscordWebhookUrl=

# --- Twitch-Worker (nur mit Profil "worker", E-032) ----------------------------
# Profil dauerhaft einschalten (auf dem Server). Lokal lieber: docker compose --profile worker up -d
# COMPOSE_PROFILES=worker

# Aus der Twitch-Entwicklerkonsole: https://dev.twitch.tv/console/apps
# Twitch__ClientId=
# Twitch__ClientSecret=

# Was gesammelt wird (Standardwerte stehen in compose.yaml):
# Worker__Languages=de
# Worker__IntervalMinutes=5
# Worker__StopAfterHours=0
# Worker__GameIds=
# Worker__UserLogins=

# --- Images ----------------------------------------------------------------------
# Lokal "local" (selbst gebaut). Auf dem Server der Commit-SHA aus der CI (Phase 6 und 8).
# IMAGE_TAG=local
