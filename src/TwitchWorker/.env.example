# Kopieren nach ".env" und ausfüllen. Die .env-Datei NIE in Git einchecken.

# Aus der Twitch-Entwicklerkonsole: https://dev.twitch.tv/console/apps
Twitch__ClientId=deine-client-id
Twitch__ClientSecret=dein-client-secret

# Passwort für die lokale Datenbank (frei wählbar)
POSTGRES_PASSWORD=bitte-ein-langes-zufaelliges-passwort
# Marktstudie: alle deutschsprachigen Streams, alle 5 Minuten, eine Woche lang (168 Stunden)
Worker__Languages=de
Worker__IntervalMinutes=5
Worker__StopAfterHours=168

# Optional: nur bestimmte Kategorien (Twitch-Game-IDs, kommagetrennt)
# Worker__GameIds=

# Optional, später für die Plattform: nur diese Kanäle (ersetzt den Sprachfilter)
# Worker__UserLogins=kanal_a,kanal_b
