{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-dd'T'HH:mm:ss.fff'Z'",
        "IncludeScopes": false,
        "JsonWriterOptions": {
          "Indented": false
        }
      }
    }
  },
  "Worker": {
    "IntervalMinutes": 5,
    "Languages": "de",
    "GameIds": "",
    "UserLogins": "",
    "StopAfterHours": 0
  }
}
