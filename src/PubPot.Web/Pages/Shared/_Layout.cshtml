<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] – PubPot</title>
    <meta name="description" content="@ViewData["Description"]" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f7f7fb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e0c18" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="~/fonts/inter-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="~/fonts/space-grotesk-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @* Bewusst im <head>: setzt das gewählte Design vor dem ersten Zeichnen, damit nichts aufblitzt. *@
    <script src="~/js/theme.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <a class="skip-link" href="#main">Zum Inhalt springen</a>

    <header class="site-header">
        <div class="container site-header__inner">
            <a class="wordmark" href="/" aria-label="PubPot – Startseite">Pub<span>Pot</span></a>

            <nav class="site-nav" aria-label="Hauptnavigation">
                <ul>
                    <li><a href="/#how">So funktioniert's</a></li>
                    <li><a href="/#developers">Für Entwickler</a></li>
                    <li><a href="/#creators">Für Creator</a></li>
                    <li><a href="/#faq">FAQ</a></li>
                </ul>
            </nav>

            <div class="header-tools">
                <button id="theme-toggle" class="icon-button" type="button" aria-pressed="false" hidden>
                    <span class="visually-hidden">Dunkles Design</span>
                    <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" /></svg>
                    <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
                </button>
            </div>
        </div>
    </header>

    <main id="main" tabindex="-1">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container site-footer__inner">
            <p>© @DateTime.UtcNow.Year PubPot</p>
            <nav aria-label="Rechtliches">
                <ul>
                    <li><a href="#">Impressum</a></li>
                    <li><a href="#">Datenschutz</a></li>
                </ul>
            </nav>
        </div>
    </footer>
</body>
</html>
