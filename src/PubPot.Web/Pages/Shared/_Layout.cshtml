@{
    var code = Lang.Code;
    var other = Lang.Other;
    var suggestion = Lang.Suggestion;
}
<!DOCTYPE html>
<html lang="@code">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] – PubPot</title>
    @if (ViewData["Description"] is string description)
    {
        <meta name="description" content="@description" />
    }
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f7f7fb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e0c18" media="(prefers-color-scheme: dark)" />
    @if (Lang.IsLocalizedPage)
    {
        <link rel="canonical" href="@Lang.CanonicalUrl" />
        @foreach (var culture in SupportedCultures.All)
        {
            <link rel="alternate" hreflang="@culture" href="@Lang.AlternateUrl(culture)" />
        }
        <link rel="alternate" hreflang="x-default" href="@Lang.DefaultUrl" />
    }
    else
    {
        <meta name="robots" content="noindex" />
    }
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="~/fonts/inter-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="~/fonts/space-grotesk-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @* Bewusst im <head>: setzt das gewählte Design vor dem ersten Zeichnen, damit nichts aufblitzt. *@
    <script src="~/js/theme.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <a class="skip-link" href="#main">@S["Layout.SkipLink"]</a>

    @if (suggestion is not null)
    {
        @* Sprachvorschlag beim ersten Besuch – in der vorgeschlagenen Sprache formuliert. *@
        var (label, text, switchText, stayText) = CurrentLanguage.InCulture(suggestion,
            () => (S["Suggest.Label"].Value, S["Suggest.Text"].Value, S["Suggest.Switch"].Value, S["Suggest.Stay"].Value));
        <aside class="notice-bar" lang="@suggestion" aria-label="@label">
            <div class="container notice-bar__inner">
                <p>@text</p>
                <div class="btn-group">
                    <a class="btn btn-primary btn-small" href="@Lang.SwitchUrl(suggestion)" rel="nofollow">@switchText</a>
                    <a class="btn btn-secondary btn-small" href="@Lang.SwitchUrl(code)" rel="nofollow">@stayText</a>
                </div>
            </div>
        </aside>
    }

    <header class="site-header">
        <div class="container site-header__inner">
            <a class="wordmark" asp-page="/Index" asp-route-culture="@code" aria-label="@S["Layout.HomeLabel"]">Pub<span>Pot</span></a>

            <nav class="site-nav" aria-label="@S["Nav.Label"]">
                <ul>
                    <li><a asp-page="/Index" asp-route-culture="@code" asp-fragment="how">@S["Nav.How"]</a></li>
                    <li><a asp-page="/Index" asp-route-culture="@code" asp-fragment="developers">@S["Nav.Developers"]</a></li>
                    <li><a asp-page="/Index" asp-route-culture="@code" asp-fragment="creators">@S["Nav.Creators"]</a></li>
                    <li><a asp-page="/Index" asp-route-culture="@code" asp-fragment="faq">@S["Nav.Faq"]</a></li>
                </ul>
            </nav>

            <div class="header-tools">
                <a class="lang-switch" href="@Lang.SwitchUrl(other)" hreflang="@other" rel="nofollow" aria-label="@S["Lang.Switch.Label"]">@S["Lang.Switch.Short"]</a>
                <button id="theme-toggle" class="icon-button" type="button" aria-pressed="false" hidden>
                    <span class="visually-hidden">@S["Theme.Toggle"]</span>
                    <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" /></svg>
                    <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
                </button>
            </div>
        </div>
    </header>

    <main id="main" tabindex="-1">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container site-footer__inner">
            <p>© @DateTime.UtcNow.Year PubPot · @S["Footer.WorkingTitle"]</p>
            <nav aria-label="@S["Footer.LegalLabel"]">
                <ul>
                    <li><a href="#">@S["Footer.Imprint"]</a></li>
                    <li><a href="#">@S["Footer.Privacy"]</a></li>
                </ul>
            </nav>
        </div>
    </footer>
</body>
</html>
