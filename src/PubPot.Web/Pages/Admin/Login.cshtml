@page
@model PubPot.Web.Pages.Admin.LoginModel
@{
    ViewData["Title"] = "Anmelden";
}

<div class="container admin-login">
    <h1>Admin-Login</h1>

    <form method="post" class="form">
        @if (Model.Error is not null)
        {
            <div class="form-summary" role="alert">
                <p>@Model.Error</p>
            </div>
        }

        <input type="hidden" asp-for="ReturnUrl" />

        <div class="field">
            <label asp-for="Username">Benutzername</label>
            <input asp-for="Username" autocomplete="username" maxlength="64" required autofocus />
        </div>

        <div class="field">
            <label asp-for="Password">Passwort</label>
            <input asp-for="Password" type="password" autocomplete="current-password" maxlength="256" required />
        </div>

        <div class="form-actions">
            <button class="btn btn-primary" type="submit">Anmelden</button>
        </div>
    </form>
</div>
