@* Layout des Admin-Bereichs: nur Deutsch (E-024), nicht indexieren, eigenes Stylesheet zusätzlich zu site.css. *@
@{
    var signedIn = User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] – PubPot Admin</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/inter-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <script src="~/js/theme.js" asp-append-version="true"></script>
</head>
<body class="admin">
    <a class="skip-link" href="#main">Zum Inhalt springen</a>

    <header class="site-header">
        <div class="container admin-header">
            <a class="wordmark" href="/admin">Pub<span>Pot</span> <small class="admin-badge">Admin</small></a>
            @if (signedIn)
            {
                <nav class="site-nav admin-nav" aria-label="Admin-Navigation">
                    <ul>
                        <li><a href="/admin">Anmeldungen</a></li>
                    </ul>
                </nav>
                @* asp-page statt action="…": Nur so fügt ASP.NET das Antiforgery-Token ein. *@
                <form method="post" asp-page="/Admin/Logout" class="admin-logout">
                    <button class="btn btn-secondary btn-small" type="submit">Abmelden</button>
                </form>
            }
        </div>
    </header>

    <main id="main" tabindex="-1">
        @RenderBody()
    </main>
</body>
</html>
