@page
@{
    ViewData["Title"] = L["Page.Title"];
    ViewData["NoIndex"] = true;
}

@* Phase 3: Token prüfen und je nach Ergebnis "bestätigt", "abgelaufen" oder "ungültig" anzeigen. *@
<div class="container page-header">
    <h1>@L["Heading"]</h1>
    <p class="lead">@L["Text"]</p>
    <a class="btn btn-primary" asp-page="/Index" asp-route-culture="@Lang.Code">@S["Common.BackHome"]</a>
</div>
