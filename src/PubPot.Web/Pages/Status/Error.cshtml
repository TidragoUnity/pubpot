@page "/error"
@* Wird bei einem POST auch per POST aufgerufen (Re-Execute). Die Seite ändert nichts, das Antiforgery-Token
   zu prüfen machte aus einem 429 oder 500 nur ein leeres 400 (gefunden in der Abnahme 5.8). *@
@attribute [Microsoft.AspNetCore.Mvc.IgnoreAntiforgeryToken]
@{
    ViewData["Title"] = S["Error.Title"];
}

<div class="container page-header">
    <h1>@S["Error.Heading"]</h1>
    <p class="lead">@S["Error.Text"]</p>
    <a class="btn btn-primary" asp-page="/Index" asp-route-culture="@Lang.Code">@S["Common.BackHome"]</a>
</div>
